# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Beta mode: shows beta notices and disables real payments. Defaults to on when unset.
# Set to false only at real launch, then rebuild/redeploy.
NEXT_PUBLIC_BETA_MODE=true

# Stripe credit purchases (currently test mode only: sk_test_ / whsec_ keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated seller profile UUIDs allowed to make test purchases.
STRIPE_TEST_SELLER_IDS=
# Origin used for Stripe success/cancel URLs, e.g. https://www.example.com
BILLING_SITE_URL=
